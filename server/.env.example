JWT_SECRET=change_me
CLIENT_URL=http://localhost:5173

# Sender address (all platform email)
SMTP_EMAIL=verifymyopus@gmail.com

# Option A — Gmail OAuth (recommended, same Google Cloud project as sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
# Optional: defaults to OAuth Playground redirect
# GOOGLE_OAUTH_REDIRECT_URI=https://developers.google.com/oauthplayground

# Option B — Gmail App Password fallback (if OAuth not configured)
SMTP_PASSWORD=your_app_password

# LiveKit Cloud (voice / video / screen share) — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Payments — eSewa UAT defaults work in sandbox. Khalti needs a test secret from the merchant dashboard.
